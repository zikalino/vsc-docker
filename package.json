{
  "name": "vsc-docker",
  "displayName": "Docker Runner",
  "description": "SmarterCode Docker Tools",
  "version": "0.51.1",
  "repository": "https://github.com/zikalino/vsc-docker",
  "publisher": "Zim",
  "icon": "media/docker-runner.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "docker",
    "azure",
    "cli"
  ],
  "activationEvents": [
    "onView:dockerRunnerExplorer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "docker-runner",
          "title": "Docker Runner",
          "icon": "media/docker-runner.png"
        }
      ]
    },
    "views": {
      "docker-runner": [
        {
          "type": "webview",
          "id": "dockerRunnerExplorer",
          "name": "Docker Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-docker-runner.refresh",
        "title": "Docker Runner: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-docker-runner.viewItem",
        "title": "View Details"
      },
      {
        "command": "vscode-docker-runner.createContainer",
        "title": "Create Container"
      },
      {
        "command": "vscode-docker-runner.deleteItem",
        "title": "Delete"
      },
      {
        "command": "vscode-docker-runner.startContainer",
        "title": "Start"
      },
      {
        "command": "vscode-docker-runner.stopContainer",
        "title": "Stop"
      },
      {
        "command": "vscode-docker-runner.restartContainer",
        "title": "Restart"
      },
      {
        "command": "vscode-docker-runner.pauseContainer",
        "title": "Pause"
      },
      {
        "command": "vscode-docker-runner.unpauseContainer",
        "title": "Unpause"
      },
      {
        "command": "vscode-docker-runner.pullImage",
        "title": "Pull Newer Version"
      },
      {
        "command": "vscode-docker-runner.pushImage",
        "title": "Push to Registry"
      },
      {
        "command": "vscode-docker-runner.saveImage",
        "title": "Save to tar File"
      },
      {
        "command": "vscode-docker-runner.createDockerfile",
        "title": "Create Dockerfile"
      },
      {
        "command": "vscode-docker-runner.execContainer",
        "title": "Execute Command"
      },
      {
        "command": "vscode-docker-runner.commitContainer",
        "title": "Commit (Create Image)"
      },
      {
        "command": "vscode-docker-runner.attachTerminal",
        "title": "Attach Terminal"
      },
      {
        "command": "vscode-docker-runner.exportContainer",
        "title": "Export to tar File"
      },
      {
        "command": "vscode-docker-runner.pruneImages",
        "title": "Docker Runner: Prune Dangling Images"
      },
      {
        "command": "vscode-docker-runner.pruneContainers",
        "title": "Docker Runner: Prune Stopped Containers"
      },
      {
        "command": "vscode-docker-runner.searchImages",
        "title": "Docker Runner: Search Images"
      },
      {
        "command": "vscode-docker-runner.loadImage",
        "title": "Docker Runner: Load Image (from save tar)"
      },
      {
        "command": "vscode-docker-runner.importImage",
        "title": "Docker Runner: Import Image (from filesystem tar)"
      },
      {
        "command": "vscode-docker-runner.createDockerfileFromContainer",
        "title": "Create Dockerfile from Changes"
      },
      {
        "command": "vscode-docker-runner.createDockerfileFromContainerId",
        "title": "Create Dockerfile from Changes (by ID)"
      },
      {
        "command": "vscode-docker-runner.browseContainerFilesystem",
        "title": "Browse Filesystem"
      },
      {
        "command": "vscode-docker-runner.openImageTable",
        "title": "Docker Runner: Images - Table View"
      },
      {
        "command": "vscode-docker-runner.openContainerTable",
        "title": "Docker Runner: Containers - Table View"
      },
      {
        "command": "vscode-docker-runner.showContextMenu",
        "title": "Actions",
        "icon": "$(ellipsis)"
      },
      {
        "command": "vscode-docker-runner.configureTerminal",
        "title": "Docker Runner: Terminal"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "vscode-docker-runner.viewItem", "when": "false" },
        { "command": "vscode-docker-runner.createContainer", "when": "false" },
        { "command": "vscode-docker-runner.deleteItem", "when": "false" },
        { "command": "vscode-docker-runner.pullImage", "when": "false" },
        { "command": "vscode-docker-runner.pushImage", "when": "false" },
        { "command": "vscode-docker-runner.saveImage", "when": "false" },
        { "command": "vscode-docker-runner.createDockerfile", "when": "false" },
        { "command": "vscode-docker-runner.startContainer", "when": "false" },
        { "command": "vscode-docker-runner.stopContainer", "when": "false" },
        { "command": "vscode-docker-runner.restartContainer", "when": "false" },
        { "command": "vscode-docker-runner.pauseContainer", "when": "false" },
        { "command": "vscode-docker-runner.unpauseContainer", "when": "false" },
        { "command": "vscode-docker-runner.attachTerminal", "when": "false" },
        { "command": "vscode-docker-runner.execContainer", "when": "false" },
        { "command": "vscode-docker-runner.commitContainer", "when": "false" },
        { "command": "vscode-docker-runner.exportContainer", "when": "false" },
        { "command": "vscode-docker-runner.createDockerfileFromContainer", "when": "false" },
        { "command": "vscode-docker-runner.createDockerfileFromContainerId", "when": "false" },
        { "command": "vscode-docker-runner.browseContainerFilesystem", "when": "false" },
        { "command": "vscode-docker-runner.showContextMenu", "when": "false" }
      ],
      "view/title": [
        {
          "command": "vscode-docker-runner.refresh",
          "when": "view == dockerRunnerExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-docker-runner.showContextMenu",
          "when": "view == dockerRunnerExplorer && viewItem == docker-image",
          "group": "inline@1"
        },
        {
          "command": "vscode-docker-runner.showContextMenu",
          "when": "view == dockerRunnerExplorer && viewItem == docker-container",
          "group": "inline@1"
        },
        {
          "command": "vscode-docker-runner.showContextMenu",
          "when": "view == dockerRunnerExplorer && viewItem == docker-image-list",
          "group": "inline@1"
        },
        {
          "command": "vscode-docker-runner.showContextMenu",
          "when": "view == dockerRunnerExplorer && viewItem == docker-container-list",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Docker Runner",
      "properties": {
        "docker-runner.executionMode": {
          "type": "string",
          "default": "some",
          "enum": [
            "none",
            "some",
            "all"
          ],
          "enumDescriptions": [
            "Run all commands in background (no terminal window). Fastest and quietest.",
            "Run user-facing operations (start, stop, pull, push, etc.) in the Docker Runner terminal. Data queries stay in background.",
            "Run every operation in the Docker Runner terminal for full visibility."
          ],
          "description": "Controls which Docker commands execute in a visible VS Code terminal vs silently in the background."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "copy-wasm": "node ./scripts/copy-wasm.js",
    "compile": "node ./scripts/copy-wasm.js && node ./esbuild.js",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.media.json",
    "validate": "node ./out/validate.js",
    "package": "node ./scripts/copy-wasm.js && node ./esbuild.js --production",
    "watch": "node ./scripts/watch.js",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.16.17",
    "esbuild-plugin-yaml": "^0.0.1",
    "eslint": "^8.54.0",
    "jsdom": "^24.0.0",
    "jsdom-global": "^3.0.2",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@vscode/codicons": "0.0.20",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "marked": "^12.0.1",
    "yaml": "^2.3.4"
  }
}
